# RepX frontend — environment variables
# Copy to .env.local to override. Defaults work for local development.
#
# Everything here is PUBLIC: Vite inlines VITE_* into the shipped bundle, so
# never put a secret in this file.

VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# OAuth client IDs. Public by design — these identify the application, they do
# not authorise anything. The matching server-side values must be set too, or
# the button will not render: the app asks GET /api/auth/providers first and
# only shows buttons the backend can actually verify.
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
