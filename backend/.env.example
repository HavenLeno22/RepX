# RepX backend — environment variables
# Copy to .env and adjust. Never commit .env.
#
# Everything here is validated at boot by src/config/env.ts. With
# NODE_ENV=production the server REFUSES TO START if the secrets are still the
# placeholders below, if they are under 32 characters, if the public URLs are
# not https, or if SMTP is unconfigured. A crash on boot is a five-minute
# outage; a silently weak signing key is a breach nobody notices.

NODE_ENV=development
PORT=4000

# ----------------------------------------------------------------- database --
# sqlite (local, zero install) | postgresql (every deployed environment).
# The value is stamped into prisma/schema.prisma by `npm run db:provider`, which
# every db:* script runs first. See docs/DEPLOYMENT.md.
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Production example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://user:password@host:5432/repx?schema=public&sslmode=require"

# Optional. When set, matchmaking/challenge/room state and WebSocket fan-out can
# move to Redis so the backend can run more than one instance. Unset = in-memory,
# single node. See docs/DEPLOYMENT.md before scaling out.
# REDIS_URL=redis://localhost:6379

# --------------------------------------------------------------------- auth --
# CHANGE BOTH before deploying anywhere reachable, and make them different from
# each other. Generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m

# ----------------------------------------------------------------- app urls --
# PUBLIC_APP_URL is where verification and password-reset links point, so it must
# be the origin a real user reaches — not localhost, and https in production
# (a reset link over http is a token in cleartext).
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How many reverse proxies sit in front of this server. Decides whether
# X-Forwarded-For is believed, and every rate-limit bucket is keyed on the IP
# that comes out of it.
#
# 0 (default) = nothing in front. Leave it at 0 locally: trusting the header
# when no proxy sets it lets any client spoof its own IP and get a fresh
# rate-limit bucket on every request, which disables the login throttle.
#
# Behind one load balancer set 1; behind Cloudflare in front of a load balancer
# set 2. Never set it higher than the real hop count — the extra hops are
# attacker-supplied.
TRUST_PROXY_HOPS=0

# --------------------------------------------------------------------- mail --
# Unset in development: account mail is written to the server log with its link
# intact, so the whole flow can be walked through without a mail server.
# REQUIRED in production — without it, anyone who forgets a password is locked
# out permanently.
#   SMTP_URL=smtps://apikey:SG.xxxx@smtp.sendgrid.net:465
# SMTP_URL=
MAIL_FROM="RepX <no-reply@repx.app>"

# -------------------------------------------------------------------- oauth --
# Only PUBLIC client identifiers. Sign-in is implemented as ID-token
# verification against each provider's published JWKS, which needs the audience
# but never a client secret — so this server holds no third-party secret at all,
# and there is none to leak or rotate.
#
# Google:  console.cloud.google.com -> Credentials -> OAuth 2.0 Client ID (Web).
#          Add your origin under "Authorised JavaScript origins".
# Apple:   developer.apple.com -> Identifiers -> Services ID. That Services ID
#          is the client id for web Sign in with Apple; add your domain and
#          return URL under "Configure".
#
# Leave blank and the matching button simply does not appear — the frontend asks
# GET /api/auth/providers which buttons to show.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
