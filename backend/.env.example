# RepX backend — environment variables
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# Local dev uses SQLite (zero install). Production targets PostgreSQL —
# see docs/DATABASE_SCHEMA.md for the migration path.
DATABASE_URL="file:./dev.db"

# Optional. When set, matchmaking/live-match state and WebSocket fan-out move to
# Redis so the backend can run multiple instances. Unset = in-memory single node.
# REDIS_URL=redis://localhost:6379

# Auth — CHANGE THESE. See docs/AUTHENTICATION.md
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OAuth — not yet wired up; email/password works today. See docs/AUTHENTICATION.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173
